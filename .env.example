# Copy to .env and fill locally. Never commit .env. Never pass keys as argv.

# IBM Quantum Platform (ibm_cloud). Both are required for a real backend job.
QKEY_IBM_API_KEY=
QKEY_IBM_INSTANCE_CRN=
# Optional override, https only.
# QKEY_IBM_API_BASE=https://quantum.cloud.ibm.com/api/v1

# Chain RPC used for CREATE2 prediction (eth_call) and optional broadcast.
QKEY_RPC_URL=https://bsc-dataseed.binance.org

# Launch signer. Pick ONE. The address must equal the frozen plan initiator.
# 1. Hex key in the environment (never printed):
# QKEY_LAUNCH_PRIVATE_KEY=
# 2. Encrypted keystore JSON:
# QKEY_LAUNCH_KEYSTORE=/absolute/path/keystore.json
# QKEY_LAUNCH_KEYSTORE_PASSWORD=
# 3. File containing the hex key (mode 0600):
# QKEY_LAUNCH_KEY_FILE=/absolute/path/launch.key
# 4. External signer (Clef / hardware bridge):
#   quantum-launch run ... --broadcast   and pass --signer-url / --signer-address via a wrapper
#   (CLI flags for the URL and public address only; the device holds the key).
